# ============================================================
# .env.example — Escuelapp Frontend (React)
# ------------------------------------------------------------
# Copia este archivo a `.env` y ajusta los valores.
# NUNCA subas el `.env` real a git (contiene claves).
# Usa el bloque LOCAL para desarrollo y el REMOTO para apuntar
# a una API en servidor.
# ============================================================

# ---------- Entorno ----------
NODE_ENV=development            # development | production

# ---------- Servidor del frontend ----------
REACT_APP_PORT=3000
PUBLIC_URL=http://localhost:3000

# ---------- URL de la API (BACKEND) ----------
# LOCAL (desarrollo)
REACT_APP_BACKEND_URL=http://localhost:4004
REACT_APP_BASE_URL=http://localhost:4004

# REMOTO (servidor) — descomenta y comenta el local
# REACT_APP_BACKEND_URL=https://api.tudominio.com
# REACT_APP_BASE_URL=https://api.tudominio.com

# ---------- App ----------
REACT_APP_PUBLIC_FOLDER=/archivos/
REACT_APP_NAME='Escuelapp'
REACT_APP_TITLE='Escuelapp'
REACT_APP_LEMA='Comunicación escolar'

# ---------- Claves ----------
# Clave de firma usada por el frontend (cambiar)
REACT_APP_JWT_PRIVATE_KEY=cambiar-clave-jwt-front
# API Key de TinyMCE (editor de texto) — opcional
REACT_APP_TINYMCE=
